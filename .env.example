# Runtime configuration is normally injected by AWS CDK.
# Slack credentials are stored in AWS Systems Manager Parameter Store, not here.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=REPLACE_WITH_BEDROCK_INFERENCE_PROFILE_ID
BEDROCK_MODEL_DISPLAY_NAME=Amazon Bedrock model
TAVILY_SEARCH_ENABLED=false
GOOGLE_DRIVE_ENABLED=false
GRAPHIC_GENERATION_ENABLED=false
