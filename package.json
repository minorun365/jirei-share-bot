{
  "name": "jirei-share-bot",
  "version": "0.1.0",
  "description": "Slackの会話から社内事例を登録・検索・定期共有するセルフホスト型Bot",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run",
    "check:public": "bash scripts/check-public.sh",
    "cdk": "cdk",
    "synth": "cdk synth --strict"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agentcore": "^3.1127.0",
    "@aws-sdk/client-dynamodb": "^3.1127.0",
    "@aws-sdk/client-lambda": "^3.1127.0",
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/client-sqs": "3.1127.0",
    "@aws-sdk/client-ssm": "3.1127.0",
    "@aws-sdk/lib-dynamodb": "^3.1127.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.163",
    "@types/node": "26.4.1",
    "aws-cdk": "2.1140.0",
    "aws-cdk-lib": "2.268.0",
    "constructs": "10.8.1",
    "esbuild": "0.28.2",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
